<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Access - Lava-Jato Palmares</title>
    <style>
        body { font-family: Arial, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #f4f4f9; margin: 0; }
       .container { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); text-align: center; max-width: 400px; width: 100%; }
        input { width: 90%; padding: 10px; margin: 10px 0; border: 1px solid #ccc; border-radius: 4px; }
        button { background-color: #007bff; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 16px; }
        button:hover { background-color: #0056b3; }
        #message { margin-top: 15px; color: #555; }
        #painel { display: none; margin-top: 20px; padding: 20px; background: #d4edda; color: #155724; border-radius: 4px; }
   </style>
</head>
<body>
    <div class="container">
        <h2>Restricted Access</h2>
        <p>Enter the administrator email to receive the magic access link.</p>

        <input type="email" id="emailInput" placeholder="Your admin email here">
        <button onclick="enviarLink()">Send Magic Link</button>

        <div id="message"></div>

        <div id="painel">
            <h3>Welcome, Administrator!</h3>
            <p>Login successful. Your admin panel will appear here.</p>
        </div>
   </div>

   <!-- Firebase SDK -->
   <script type="module">
       import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
       import { getAuth, sendSignInLinkToEmail, isSignInWithEmailLink, signInWithEmailLink } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

       // Your Firebase configuration (Get these details from the Firebase console under Project Settings)
       const firebaseConfig =
       {
           apiKey: "YOUR_API_KEY_HERE",
           authDomain: "lava-jato-palmares-b-a-093.firebaseapp.com",
           projectId: "lava-jato-palmares-b-a-093",
           storageBucket: "lava-jato-palmares-b-a-093.appspot.com",
           messagingSenderId: "YOUR_SENDER_ID_HERE",
           appId: "YOUR_APP_ID_HERE"
       };

       const app = initializeApp(firebaseConfig);
       const auth = getAuth(app);

       const adminEmail = "lavajotapalmares375@gmail.com";
       const actionCodeSettings =
       {
           url: 'https://ccn-3-7-5.github.io/Lava-jato-palmares-B-A-093/admin.html', // Link to your site
           handleCodeInApp: true,
       };

       // Function to send the link
       window.enviarLink = function() {
           const email = document.getElementById('emailInput').value;
           if (email!== adminEmail) {
               document.getElementById('message').innerText = "Access denied. This email is not an administrator.";
               return;
           }

           sendSignInLinkToEmail(auth, email, actionCodeSettings)
               .then(() => {
                   window.localStorage.setItem('emailForSignIn', email);
                   document.getElementById('message').innerText = "Link sent! Check your email.";
              })
               .catch((error) => {
                   document.getElementById('message').innerText = "Error: " + error.message;
               });
       }

       // Checks if the user returned by clicking on the email link
       if (isSignInWithEmailLink(auth, window.location.href)) {
           let email = window.localStorage.getItem('emailForSignIn');
           if (!email) {
               email = window.prompt('Please confirm your email to complete login:');
           }

           signInWithEmailLink(auth, email, window.location.href)
              .then(() => {
                   window.localStorage.removeItem('emailForSignIn');
                   document.querySelector('.container h2').innerText = "Access Granted!";
                   document.getElementById('emailInput').style.display = 'none';
                   document.querySelector('button').style.display = 'none';
                   document.getElementById('message').innerText = "";
                   document.getElementById('painel').style.display = 'block';
              })
               .catch((error) => {
                   document.getElementById('message').innerText = "Error logging in: " + error.message;
               });
       }
   </script>
</body>
</html>
